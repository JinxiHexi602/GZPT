#!name = 华辰杰 doneTargetTimes/donePercent
#!desc = 修改 run-front/querySunRunAbstractInfoV2 返回中的 doneTargetTimes、donePercent，参数在插件详情页图形化调整
#!author = JinxiHexi602
#!homepage = https://github.com/JinxiHexi602/GZPT
#!date = 2026-11-26
#!tag = run-front
#!type = normal
#!loon_version = 3.2.1(733)

[Argument]
doneTargetTimes = input,30,type=number,tag=目标次数,desc=doneTargetTimes 改成多少；填 -1 表示这一项不改
donePercent = input,83.3,type=number,tag=完成百分比,desc=donePercent 改成多少（接口是 0-1 小数就填 0.99）；填 -1 表示这一项不改
debug = switch,false,tag=调试日志,desc=在 Loon 日志里打印改前、改后的完整 JSON
enabled = switch,true,tag=启用

[Script]
http-response ^https:\/\/api\.huachenjie\.com\/run-front\/run\/querySunRunAbstractInfoV2 script-path=https://github.com/JinxiHexi602/GZPT/raw/refs/heads/main/huachenjie-done-target-times.js, requires-body=1, timeout=60, tag=doneTargetTimes, argument=[{doneTargetTimes},{donePercent},{debug}], enable={enabled}

[MITM]
hostname = %APPEND% api.huachenjie.com
